# Shareable template only. Never put private values in this file.
# Keep an existing local .env; do not overwrite it with this template.

# Required for CourtListener API checks.
COURTLISTENER_TOKEN=

# Optional PostgreSQL backend. Empty/unset keeps local SQLite.
# Set the provider-issued connection URL privately, including its TLS settings.
# Existing SQLite data is NOT migrated automatically.
DATABASE_URL=

# Reserved for future LLM analysis; NOT used by current code.
LLM_API_KEY=

# Required only when sending email with --send-email.
# TLS: port 465; STARTTLS: port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
