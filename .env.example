# Shareable template only. Never put private values in this file.
# Keep an existing local .env; do not overwrite it with this template.

# Required for CourtListener API checks.
COURTLISTENER_TOKEN=

# PostgreSQL (Supabase) connection URI. Required by the pipeline and src.admin
# unless --sqlite is used for local development. TLS is enforced.
DATABASE_URL=

# Required only when sending email (pipeline deliver stage or legacy --send-email).
# TLS: port 465; STARTTLS: port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Legacy single-recipient flow only; the pipeline reads recipients from the database.
EMAIL_TO=

# Optional: overrides pipeline.analyzer in config.yaml (rules | rules+shadow | llm).
ANALYZER=

# LLM provider settings. The model is configuration, never code.
# LLM_PROVIDER is the API format, not the company: any OpenAI-compatible API
# (DeepSeek, OpenAI, Qwen, Kimi, OpenRouter, Ollama, vLLM ...) uses openai_compatible.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Provider-specific request fields as JSON. DeepSeek: disable billed "thinking" output.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
